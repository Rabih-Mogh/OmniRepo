<resources>
    <string name="app_name">Spark</string>

    <!-- The first screen -->
    <string name="welcome_title">What do you want to learn?</string>
    <string name="welcome_body">Spark shows you short reels, learns which ones hold your attention, and turns the best into lessons you do, not just read. Write anything you\'d like to learn about. You can change the list at any time.</string>
    <string name="welcome_start">Start</string>
    <string name="wish_hint">A subject, a question, a skill</string>
    <string name="add">Add</string>
    <string name="remove_item">Remove %1$s</string>
    <string name="back">Back</string>

    <!-- Subjects and kinds of reel -->
    <string name="topic_maths">Maths</string>
    <string name="topic_science">Science</string>
    <string name="topic_computing">Computing</string>
    <string name="topic_ideas">Ideas</string>
    <string name="kind_news">News</string>
    <string name="kind_puzzle">Puzzle</string>

    <!-- The feed -->
    <string name="reel_reveal">Show the answer</string>
    <string name="reel_like">Like</string>
    <string name="reel_liked">Liked</string>
    <string name="reel_less">Not for me</string>
    <string name="reel_lesson">Take the lesson</string>
    <string name="reel_lesson_done">Lesson finished</string>
    <string name="reel_source">Source: %1$s</string>
    <string name="feed_progress">%1$d/%2$d</string>
    <string name="feed_you">Your progress and settings</string>
    <string name="done_title">Done for today</string>
    <string name="done_body">%1$d reels and a lesson: that\'s today\'s goal. Come back tomorrow, or swipe up if you want more.</string>
    <string name="done_body_no_lesson">%1$d reels: that\'s today\'s goal. Come back tomorrow, or swipe up if you want more.</string>
    <string name="done_lesson_title">One lesson to go</string>
    <string name="done_lesson_body">You\'ve watched today\'s reels. Finish a lesson to complete the day.</string>
    <string name="done_lesson_button">Take a lesson</string>
    <string name="done_reels_title">Nearly there</string>
    <plurals name="done_reels_body">
        <item quantity="one">%1$d more reel completes today\'s goal.</item>
        <item quantity="other">%1$d more reels complete today\'s goal.</item>
    </plurals>
    <string name="end_title">That\'s everything for now</string>
    <string name="end_body">A new batch is prepared every morning. Tell Spark what you want to learn, and it will be in a coming one.</string>
    <string name="end_wishes">What I want to learn</string>

