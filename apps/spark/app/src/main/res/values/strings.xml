    <!-- The screen about you -->
    <string name="you_streak">Streak</string>
    <string name="you_streak_about">A day counts once you watch %1$d reels or finish a lesson. One missed day a week is let go.</string>
    <plurals name="days">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
    </plurals>
    <string name="you_today">Today</string>
    <string name="you_today_reels">%1$d of %2$d reels</string>
    <string name="you_lesson_done">Lesson done</string>
    <string name="you_lesson_todo">Lesson to do</string>
    <string name="you_lesson_none">No lesson left to take</string>
    <string name="goal_title">Daily goal</string>
    <string name="goal_about">Reels a day, with one lesson. After that the feed tells you you\'re done.</string>
    <string name="goal_reels">%1$d reels</string>
    <string name="sounds_title">Sounds and vibration</string>
    <string name="sounds_about">A little chime and a tap of vibration when you answer, finish a lesson or reach your goal. The chimes keep quiet while the phone is on silent.</string>
    <string name="wishes_title">What I want to learn</string>
    <string name="wishes_about">Reels that match come first in your feed. To have new reels and lessons made for the list, send it.</string>
    <string name="wishes_empty">Nothing yet.</string>
    <string name="wishes_send">Send the list</string>
    <string name="wishes_send_about">This opens a new issue on the app\'s GitHub repo, with your list and a summary of what has held your attention filled in. Submit it there, signed in as the repo\'s owner, and the next morning\'s batch uses it. The issue is public.</string>
    <string name="wishes_send_failed">No app on this phone opens web pages.</string>
    <string name="taste_title">What Spark has learned</string>
    <string name="taste_about">How much each subject has held your attention so far. This is what orders your feed.</string>
    <string name="taste_empty">Watch a few reels first.</string>
    <string name="lessons_title">Lessons</string>
    <string name="lessons_score">%1$d/%2$d</string>
    <string name="library_title">Library</string>
    <string name="library_count">%1$d reels and %2$d lessons, %3$d reels not seen yet.</string>
    <string name="library_fetch">Look for new reels</string>
    <string name="library_looking">Looking…</string>
    <plurals name="library_found">
