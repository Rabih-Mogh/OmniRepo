<?xml version="1.0" encoding="utf-8"?>
<!-- Fajr: the sun coming up from behind the shoulder of a mountain, as it does over the mountains of Lebanon. White, to be tinted where it is shown. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- The sun, to one side of the peak and cut off a little above the ridge so that it reads as behind it. -->
    <group>
        <clip-path android:pathData="M0,0 H24 V21.5 L22.5,19.6 L15.5,10.6 L13.2,13.6 L9,7.1 L1.5,19.6 L0,21 Z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M13.9,11.5 a3.6,3.6 0 1,0 7.2,0 a3.6,3.6 0 1,0 -7.2,0 Z" />
    </group>
    <!-- Its rays, fanned round the part that shows. -->
    <path
        android:pathData="M17.5,6.4 V4.8 M21.1,7.9 L22.2,6.8 M22.6,11.5 H23.6 M13.9,7.9 L12.8,6.8"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.6" />
    <!-- A high peak and a lower shoulder. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M1.5,21 L9,8.5 L13.2,15 L15.5,12 L22.5,21 Z" />
</vector>
