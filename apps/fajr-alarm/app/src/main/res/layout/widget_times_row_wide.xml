<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the table where the widget is wide: when the time begins and when it ends, each in a column of its own. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp">

    <!-- A dot for an obligatory prayer, a ring for a voluntary one; kept as a gap before sunrise and midnight. -->
    <ImageView
        android:id="@+id/row_mark"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginEnd="5dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_mark_dot"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="@color/widget_text"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/row_bell"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginHorizontal="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_bell"
        android:visibility="gone" />

    <TextView
        android:id="@+id/row_time"
        android:layout_width="78dp"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAlignment="viewEnd"
        android:textColor="@color/widget_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/row_ends"
        android:layout_width="78dp"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAlignment="viewEnd"
        android:textColor="@color/widget_muted"
        android:textSize="13sp" />
</LinearLayout>
