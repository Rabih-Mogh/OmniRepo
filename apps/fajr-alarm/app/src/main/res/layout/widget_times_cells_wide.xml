<?xml version="1.0" encoding="utf-8"?>
<!-- The cells of a row where the widget is wide: when the time begins and when it ends, each in a column of its own. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Kept as a gap before Imsak, sunrise and midnight, which are not prayers. -->
    <ImageView
        android:id="@+id/row_mark"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginEnd="5dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_prayer_dhuhr"
        android:visibility="invisible" />

    <!-- The name, and right after it on the current prayer's row the time it has left. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/row_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/row_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/row_left_icon"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_hourglass" />

            <Chronometer
                android:id="@+id/row_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_on_gold"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/row_bell"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginHorizontal="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_alert_sound"
        android:visibility="gone" />

    <TextView
        android:id="@+id/row_time"
        android:layout_width="78dp"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAlignment="viewEnd"
        android:textColor="@color/widget_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/row_ends"
        android:layout_width="78dp"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAlignment="viewEnd"
        android:textColor="@color/widget_muted"
        android:textSize="13sp" />
</LinearLayout>
