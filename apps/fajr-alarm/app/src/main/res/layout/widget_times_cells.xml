<?xml version="1.0" encoding="utf-8"?>
<!-- The cells of a row of the table: the prayer's icon, its name, the time left if it is the current one, and its clock time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- The time's icon, in three sizes: the one that suits the row's height is shown, since a
         view's size can't be set from outside on older phones. -->
    <ImageView
        android:id="@+id/row_mark"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="5dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_prayer_dhuhr"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/row_mark_medium"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="5dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_prayer_dhuhr"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/row_mark_large"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_prayer_dhuhr"
        android:visibility="gone" />

    <TextView
        android:id="@+id/row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="@color/widget_text"
        android:textSize="12sp" />

    <!-- On the highlighted row, at the right: the time the current prayer has left, behind an hourglass on a
         filled pill; or the wait for the next one, behind a clock on an outlined pill. -->
    <RelativeLayout
        android:id="@+id/row_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <!-- The filled pill behind it, in the colour of the row's text; the time left is then in the row's own colour.
             It takes its size from the words it sits behind. -->
        <ImageView
            android:id="@+id/row_left_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/row_left_content"
            android:layout_alignEnd="@+id/row_left_content"
            android:layout_alignStart="@+id/row_left_content"
            android:layout_alignTop="@+id/row_left_content"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_chip" />

        <!-- Shown where the row is the next prayer, not the current one: the row's own colour inside
             the pill leaves only its outline, so a wait reads differently from time left. -->
        <ImageView
            android:id="@+id/row_left_fill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/row_left_content"
            android:layout_alignEnd="@+id/row_left_content"
            android:layout_alignStart="@+id/row_left_content"
            android:layout_alignTop="@+id/row_left_content"
            android:layout_margin="1.5dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_chip"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/row_left_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="3dp"
            android:paddingVertical="1dp">

            <ImageView
                android:id="@+id/row_left_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_hourglass" />

            <Chronometer
                android:id="@+id/row_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_on_gold"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <TextView
        android:id="@+id/row_time"
        android:layout_marginStart="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
