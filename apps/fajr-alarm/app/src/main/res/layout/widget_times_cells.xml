<?xml version="1.0" encoding="utf-8"?>
<!-- The cells of a row of the table: the prayer's icon, its name, a bell if it notifies, and its clock time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Kept as a gap before Imsak, sunrise and midnight, which are not prayers. -->
    <ImageView
        android:id="@+id/row_mark"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginEnd="5dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_prayer_dhuhr"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="@color/widget_text"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/row_bell"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginHorizontal="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_bell"
        android:visibility="gone" />

    <TextView
        android:id="@+id/row_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/row_ends"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
