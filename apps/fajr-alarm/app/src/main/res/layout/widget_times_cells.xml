<?xml version="1.0" encoding="utf-8"?>
<!-- The cells of a row of the table: the prayer's icon, its name, the time left if it is the current one, what the phone does when it arrives, and its clock time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Kept as a gap before Imsak, sunrise and midnight, which are not prayers. -->
    <ImageView
        android:id="@+id/row_mark"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="5dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_prayer_dhuhr"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="@color/widget_text"
        android:textSize="12sp" />

    <!-- On the current prayer's row: the time it has left, at the right behind an hourglass. -->
    <LinearLayout
        android:id="@+id/row_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/row_left_icon"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_hourglass" />

        <Chronometer
            android:id="@+id/row_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_gold"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/row_bell"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginHorizontal="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_alert_sound"
        android:visibility="gone" />

    <TextView
        android:id="@+id/row_time"
        android:layout_marginStart="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
