    <string name="app_name">الحارس</string>

    <!-- What Android shows about the app in its own settings -->
    <string name="watch_about">يرى «الحارس» التطبيق الظاهر أمامك، ويقرأ النص المعروض في المتصفحات ومتاجر التطبيقات وإعدادات الهاتف، ليغلق ما طلبت منه إغلاقه. لا يُحفظ شيء مما يراه ولا يغادر الهاتف.</string>
    <string name="admin_about">يمنع إلغاء تثبيت «الحارس» ما دام هذا مفعّلاً. لا يستخدم أي صلاحية أخرى لمشرف الجهاز.</string>
    <string name="admin_warning">يمكن إلغاء تثبيت «الحارس» بعد إيقاف هذا.</string>

