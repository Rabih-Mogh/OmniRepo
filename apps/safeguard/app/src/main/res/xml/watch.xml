<?xml version="1.0" encoding="utf-8"?>
<!-- What the watching service asks Android for: when the window in front changes or its
     content does, and to read that window's text. View names are how an address bar is told
     from the page under it. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/watch_about"
    android:notificationTimeout="150"
    android:settingsActivity="app.safeguard.MainActivity" />
