<?xml version="1.0" encoding="utf-8"?>
<!-- Every text the app shows. Each one has an Arabic counterpart in values-ar/strings.xml. -->
<resources>
    <string name="app_name">Safeguard</string>

    <!-- What Android shows about the app in its own settings -->
    <string name="watch_about">Safeguard sees which app is in front, and reads the text on screen in browsers, app stores and the phone\'s settings, to close what you asked it to close. Nothing it sees is kept or leaves the phone.</string>
    <string name="admin_about">Keeps Safeguard from being uninstalled while this is on. It uses no other device admin power.</string>
    <string name="admin_warning">Safeguard can be uninstalled once this is off.</string>

    <!-- Setting up -->
    <string name="watch_off_title">Safeguard isn\'t watching</string>
    <string name="watch_off_body">Nothing is closed until Safeguard is switched on under the phone\'s Accessibility settings. If the phone says the setting is restricted, open the app\'s info page, tap the three dots at the top and choose Allow restricted settings, then try again.</string>
    <string name="watch_open">Open Accessibility settings</string>
    <string name="watch_info">Open the app\'s info page</string>
    <string name="admin_off_title">Safeguard can be uninstalled</string>
    <string name="admin_off_body">A device admin app can\'t be uninstalled until that is switched off again, and a locked Safeguard keeps that page closed.</string>
    <string name="admin_allow">Make it a device admin app</string>
    <string name="admin_stop">Stop being a device admin app</string>
    <string name="installs_off_title">Updates need a setting</string>
    <string name="installs_off_body">Allow Safeguard to install its own updates now. Once it is locked, that settings page is closed like the others about it.</string>
    <string name="installs_allow">Allow updates</string>

    <!-- Locking -->
    <string name="lock_off_title">Unlocked</string>
    <string name="lock_off_body">Every change takes effect at once, and Safeguard can be switched off or removed. Lock it when the lists below are as you want them.</string>
    <string name="lock">Lock</string>
    <string name="lock_confirm_title">Lock Safeguard?</string>
    <string name="lock_confirm_body">From then on, taking anything off the lists, loosening a limit, unlocking, switching Safeguard off or removing it takes %1$s from when you ask.</string>
    <string name="lock_on_title">Locked</string>
    <string name="lock_on_body">Adding to the lists is immediate. Taking anything off, loosening a limit or unlocking takes %1$s from when you ask.</string>
    <string name="unlock_ask">Ask to unlock</string>
    <string name="wait_change">Waiting period: %1$s</string>
    <string name="wait_title">Waiting period</string>
    <string name="wait_about">How long a change that loosens anything waits while Safeguard is locked. A longer period starts at once; a shorter one waits out the period you have now.</string>
    <string name="cancel">Cancel</string>
    <plurals name="hours">
        <item quantity="one">%1$d hour</item>
        <item quantity="other">%1$d hours</item>
    </plurals>
    <plurals name="days">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
    </plurals>

