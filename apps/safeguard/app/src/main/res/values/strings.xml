    <!-- The lists -->
    <string name="apps_title">Blocked apps</string>
    <string name="apps_about">These can\'t be opened, and their page in the app store and Android\'s install prompt are closed, so they can\'t be installed either. Choose apps that are on the phone, or type the name of one that isn\'t, as the store shows it, like TikTok.</string>
    <string name="apps_choose">Choose from this phone</string>
    <string name="apps_hint">App name</string>
    <string name="sites_title">Blocked websites</string>
    <string name="sites_about">Closed in any browser, with everything under them: example.com also covers m.example.com.</string>
    <string name="sites_hint">example.com</string>
    <string name="sites_error">That isn\'t a website address.</string>
    <string name="keywords_title">Blocked words</string>
    <string name="keywords_about">A browser page that shows one of these, in its address or its text, is closed.</string>
    <string name="keywords_hint">Word or phrase</string>

