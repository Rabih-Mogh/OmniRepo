    <string name="why_spent">Today\'s %2$d minutes of %1$s are used up. It opens again tomorrow.</string>
    <string name="why_never">%1$s is on your list of blocked apps.</string>
    <string name="why_site">%1$s is on your list of blocked websites.</string>
