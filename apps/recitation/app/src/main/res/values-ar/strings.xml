    <string name="tajweed_intro">تُلوَّن حروف كل آية بحسب حكم تلاوتها، برواية حفص عن عاصم. والأحكام التي تتبع موضع الوقف تجري على وقف القارئ في التسجيل.</string>
    <string name="tajweed_plain">الحروف المُظهَرة، والمدّ الطبيعي المكتوب بحرف كامل، تبقى بلون النص.</string>
    <string name="tajweed_family_nasal">حركتان</string>
    <string name="tajweed_family_madd_lazim">٦ حركات</string>
    <string name="tajweed_family_madd_wajib">٤ أو ٥ حركات</string>
    <string name="tajweed_family_madd_jaiz">٢ أو ٤ أو ٦ حركات</string>
    <string name="tajweed_family_madd_tabii">حركتان</string>
    <string name="tajweed_family_echo">اضطراب الحرف الساكن عند النطق به</string>
    <string name="tajweed_family_heavy">امتلاء الفم بصوت الحرف</string>
    <string name="tajweed_family_quiet">ما يُدغم إدغامًا كاملًا، وما يُكتب ولا يُنطق</string>
    <string name="tajweed_ghunnah">تُغَنّ النون والميم المشدَّدتان بمقدار حركتين.</string>
    <string name="tajweed_ikhfa">النون الساكنة أو التنوين قبل خمسة عشر حرفًا (ت ث ج د ذ ز س ش ص ض ط ظ ف ق ك): تُنطق بين الإظهار والإدغام مع بقاء الغنّة.</string>
    <string name="tajweed_ikhfa_shafawi">الميم الساكنة قبل الباء: تُخفى مع الغنّة.</string>
    <string name="tajweed_iqlab">النون الساكنة أو التنوين قبل الباء: تُقلب ميمًا مع الغنّة، وعلامته ميم صغيرة.</string>
    <string name="tajweed_idgham_ghunnah">النون الساكنة أو التنوين آخر الكلمة قبل أحد حروف (ي ن م و) أول الكلمة التالية: تُدغم مع الغنّة.</string>
    <string name="tajweed_idgham_shafawi">الميم الساكنة قبل ميم: تُدغم فيها مع الغنّة.</string>
    <string name="tajweed_madd_lazim">حرف مدّ بعده سكون أصلي أو حرف مشدَّد، ومنه الحروف المقطّعة في فواتح السور: يُمدّ ستّ حركات لزومًا.</string>
    <string name="tajweed_madd_muttasil">حرف مدّ بعده همزة في الكلمة نفسها: يُمدّ أربع أو خمس حركات.</string>
    <string name="tajweed_madd_munfasil">حرف مدّ آخر الكلمة وبعده همزة أول الكلمة التالية: يُمدّ أربع أو خمس حركات لحفص، ويجوز قصره. ولا يكون إلا في الوصل.</string>
    <string name="tajweed_madd_silah_kubra">هاء الضمير قبل همزة: تُمدّ كالمدّ المنفصل.</string>
    <string name="tajweed_madd_arid">حرف مدّ قبل الحرف الأخير الموقوف عليه: يُمدّ حركتين أو أربعًا أو ستًّا.</string>
    <string name="tajweed_madd_lin">واو أو ياء ساكنة قبلها فتحة، قبل الحرف الأخير الموقوف عليه: تُمدّ حركتين أو أربعًا أو ستًّا.</string>
    <string name="tajweed_madd_tabii">المدّ الأصلي، ومقداره حركتان. ويُلوَّن حيث يُكتب في المصحف بحرف صغير.</string>
    <string name="tajweed_madd_silah_sughra">هاء الضمير بين متحرّكين: تُمدّ حركتين في الوصل.</string>
    <string name="tajweed_madd_iwad">الوقف على تنوين الفتح: يُبدل ألفًا تُمدّ حركتين.</string>
    <string name="tajweed_qalqalah">حروف (ق ط ب ج د) إذا سكنت أو وُقف عليها، وهي أقوى عند الوقف.</string>
    <string name="tajweed_tafkhim_ra">تُفخَّم الراء المفتوحة والمضمومة، والساكنة بعد فتح أو ضمّ. وتُرقَّق المكسورة والساكنة بعد كسر فتبقى بلون النص.</string>
    <string name="tajweed_tafkhim_lam">تُفخَّم لام لفظ الجلالة بعد فتح أو ضمّ، وتُرقَّق بعد كسر.</string>
    <string name="tajweed_idgham_bila_ghunnah">النون الساكنة أو التنوين قبل اللام أو الراء: تُدغم إدغامًا كاملًا بلا غنّة.</string>
    <string name="tajweed_idgham_mutamathilayn">حرف ساكن بعده مثله: يُدغم فيه.</string>
    <string name="tajweed_idgham_mutajanisayn">حرفان اتّحدا مخرجًا واختلفا صفةً: (ت د ط) و(ث ذ ظ) والباء في الميم.</string>
    <string name="tajweed_idgham_mutaqaribayn">حرفان تقاربا مخرجًا أو صفةً: اللام في الراء، والقاف في الكاف.</string>
    <string name="tajweed_lam_shamsiyyah">لام «ال» قبل حرف شمسي: لا تُنطق ويُشدَّد الحرف بعدها.</string>
    <string name="tajweed_hamzat_wasl">تُنطق عند الابتداء بها وتسقط في الوصل.</string>
    <string name="tajweed_silent">حروف تُكتب في المصحف ولا تُنطق، وعلامتها دائرة صغيرة.</string>
